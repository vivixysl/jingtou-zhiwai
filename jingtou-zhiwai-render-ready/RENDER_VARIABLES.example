# Render Blueprint will request OPENAI_API_KEY and GAME_PIN securely at deployment.
# Do NOT put your real key/password into this file or commit them to GitHub!
# OPENAI_API_KEY=[only set in Render dashboard]
# GAME_PIN=[only set in Render dashboard]
# SESSION_SECRET=[generated securely by Render]
CLOUD_MODE=1
HOST=0.0.0.0
DATA_DIR=/app/data
OPENAI_MODEL=gpt-4.1-mini
